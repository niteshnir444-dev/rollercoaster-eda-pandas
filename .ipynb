
Step 0: Imports and Reading Data
Python
import pandas as pd
import numpy as np
import matplotlib.pylab as plt
import seaborn as sns

plt.style.use('ggplot')
pd.set_option('display.max_columns', 200)

df = pd.read_csv('coaster_db.csv')
Step 1: Data Understanding
Python
# Check rows and columns (rows, columns)
df.shape

# Preview first 12 rows
df.head(12)

# Check column names and data types
df.columns
df.dtypes

# Summary statistics for numeric columns
df.describe()
Step 2: Data Preparation
Python
# Keep only relevant columns
df = df[['coaster_name',
         'Location', 'Status',
         'Manufacturer',
         'year_introduced',
         'latitude', 'longitude',
         'Type_Main',
         'opening_date_clean',
         'speed_mph',
         'height_ft',
         'Inversions_clean', 'Gforce_clean']].copy()

# Convert opening date to datetime
df['opening_date_clean'] = pd.to_datetime(df['opening_date_clean'])

# Rename columns
df = df.rename(columns={'coaster_name': 'Coaster_Name',
                        'year_introduced': 'Year_Introduced',
                        'opening_date_clean': 'Opening_Date',
                        'speed_mph': 'Speed_mph',
                        'height_ft': 'Height_ft',
                        'Inversions_clean': 'Inversions',
                        'Gforce_clean': 'Gforce'})

# Check missing values per column
df.isna().sum()

# Check for duplicate rows and duplicate coaster names
df.loc[df.duplicated()]
df.loc[df.duplicated(subset=['Coaster_Name'])].head(5)

# Inspect a specific duplicate example
df.query('Coaster_Name == "Crystal Beach Cyclone"')

# Remove duplicates and reset index
df = df.loc[~df.duplicated(subset=['Coaster_Name', 'Location', 'Opening_Date'])] \
    .reset_index(drop=True).copy()
Step 3: Feature Understanding (Univariate Analysis)
Python
# Top 10 years coasters were introduced
ax = df['Year_Introduced'].value_counts() \
    .head(10) \
    .plot(kind='bar', title='Top 10 Years Coasters Introduced')
ax.set_xlabel('Year Introduced')
ax.set_ylabel('Count')
plt.show()

# Histogram of coaster speeds
ax = df['Speed_mph'].plot(kind='hist',
                          bins=20,
                          title='Coaster Speed (mph)')
ax.set_xlabel('Speed (mph)')
plt.show()

# KDE density plot of coaster speeds
ax = df['Speed_mph'].plot(kind='kde',
                          title='Coaster Speed (mph)')
ax.set_xlabel('Speed (mph)')
plt.show()

# Count by main coaster material type
df['Type_Main'].value_counts()
Step 4: Feature Relationships (Multivariate Analysis)
Python
# Scatter plot: Speed vs. Height (Matplotlib)
df.plot(kind='scatter',
        x='Speed_mph',
        y='Height_ft',
        title='Coaster Speed vs. Height')
plt.show()

# Scatter plot: Speed vs. Height colored by Year (Seaborn)
ax = sns.scatterplot(x='Speed_mph',
                     y='Height_ft',
                     hue='Year_Introduced',
                     data=df)
ax.set_title('Coaster Speed vs. Height')
plt.show()

# Pairplot across key numeric features
sns.pairplot(df,
             vars=['Year_Introduced', 'Speed_mph',
                   'Height_ft', 'Inversions', 'Gforce'],
             hue='Type_Main')
plt.show()

# Correlation matrix and heatmap
df_corr = df[['Year_Introduced', 'Speed_mph',
              'Height_ft', 'Inversions', 'Gforce']].dropna().corr()

sns.heatmap(df_corr, annot=True)
plt.show()
Step 5: Ask a Question About the Data
Python
# What are the locations with the fastest roller coasters (minimum of 10 coasters)?
ax = df.query('Location != "Other"') \
    .groupby('Location')['Speed_mph'] \
    .agg(['mean', 'count']) \
    .query('count >= 10') \
    .sort_values('mean')['mean'] \
    .plot(kind='barh', figsize=(12, 5), title='Average Coaster Speed by Location')
ax.set_xlabel('Average Coaster Speed (mph)')
plt.show()
